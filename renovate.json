{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "kubernetes": {
    "fileMatch": ["(^|/).*\\.yaml$"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/).*\\.md$"],
      "matchStrings": [
        "factory\\.talos\\.dev/installer/[a-f0-9]+:(?<currentValue>v[\\d\\.]+)"
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases",
      "autoReplaceStringTemplate": "factory.talos.dev/installer/{{#each matches}}{{lookup . 'groups'}}{{/each}}:{{newValue}}"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["siderolabs/talos"],
      "groupName": "Talos",
      "automerge": false,
      "labels": ["dependencies", "talos"]
    },
    {
      "matchPackageNames": ["vllm/vllm-openai"],
      "groupName": "vLLM",
      "automerge": false,
      "labels": ["dependencies", "vllm"]
    },
    {
      "matchPackageNames": ["nvcr.io/nvidia/vllm"],
      "groupName": "NVIDIA vLLM",
      "automerge": false,
      "labels": ["dependencies", "vllm"],
      "versioning": "loose"
    },
    {
      "matchPackageNames": ["ghcr.io/open-webui/open-webui"],
      "groupName": "open-webui",
      "automerge": false,
      "labels": ["dependencies", "apps"]
    },
    {
      "matchPackageNames": ["ghcr.io/berriai/litellm"],
      "groupName": "litellm",
      "automerge": false,
      "labels": ["dependencies", "apps"]
    },
    {
      "matchPackageNames": ["ghcr.io/agent-substrate/substrate"],
      "groupName": "substrate",
      "automerge": false,
      "labels": ["dependencies", "apps"]
    },
    {
      "matchPackageNames": ["rocm/vllm-openai"],
      "groupName": "ROCm vLLM",
      "automerge": false,
      "labels": ["dependencies", "vllm"],
      "versioning": "loose"
    },
    {
      "matchPackageNames": ["intel/vllm-xpu"],
      "groupName": "Intel XPU vLLM",
      "automerge": false,
      "labels": ["dependencies", "vllm"],
      "versioning": "loose"
    },
    {
      "matchPackageNames": ["ghcr.io/tenstorrent/tt-inference-server/vllm-tt-metal-src-release-ubuntu-22.04-amd64"],
      "groupName": "Tenstorrent vLLM",
      "automerge": false,
      "labels": ["dependencies", "vllm"],
      "versioning": "loose"
    }
  ]
}
